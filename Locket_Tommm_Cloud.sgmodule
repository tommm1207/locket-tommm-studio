#!name=Locket Gold • ✨Tommm✨ (Cloud 24/7)
#!desc=Mở khóa Locket Gold VIP, 360+ Captions tự cập nhật ngày lễ, Thứ Ngày Đa Ngôn Ngữ, Rollcall Strip & All Apps — By ✨Tommm✨
#!system=ios

[Rule]
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,crashlytics.com,REJECT
DOMAIN-SUFFIX,amplitude.com,REJECT
DOMAIN-SUFFIX,appsflyersdk.com,REJECT
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,music.youtube.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,s.youtube.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,www.youtube.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,m.youtube.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) header-del x-revenuecat-etag
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) header-del X-RevenueCat-ETag
http-request ^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a header-del If-None-Match
http-request ^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a header-del if-none-match
http-request ^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a header-del Accept-Encoding
http-request ^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a header-del accept-encoding
http-request ^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/(?!(generateFilteredImage|generateFilter|applyFilter|createFilter|generateCaption|ai-filters)).+ header-del If-None-Match
http-request ^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/(?!(generateFilteredImage|generateFilter|applyFilter|createFilter|generateCaption|ai-filters)).+ header-del if-none-match
http-request ^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/(?!(generateFilteredImage|generateFilter|applyFilter|createFilter|generateCaption|ai-filters)).+ header-del Accept-Encoding
http-request ^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/(?!(generateFilteredImage|generateFilter|applyFilter|createFilter|generateCaption|ai-filters)).+ header-del accept-encoding
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[URL Rewrite]
^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/.*(generateFilteredImage|generateFilter|applyFilter|createFilter|createCustomFilter|generateCustomFilter|createCameraFilter|createAiFilter|generateAiFilter|createUserFilter|saveFilter|saveCustomFilter|createLook|generateLook|customFilter|customFilters|userFilters|validateFilter|checkFilter|generateCaption|ai-filters)(.*) 'https://locket-tommm-studio.khoinguyennguyen85.workers.dev/$2$3' header
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad 'data-type=text data="" status-code=200'

[Script]
tommm_gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://tommm1207.github.io/locket-tommm-studio/js_tommm_gold.js?v=58, requires-body=true, max-size=-1, timeout=60
tommm_del_header = type=http-request, pattern=^https:\/\/(api\.revenuecat\.com\/.+\/(receipts|subscribers)|firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a), script-path=https://tommm1207.github.io/locket-tommm-studio/js_tommm_deleteHeader.js?v=58, timeout=60
tommm_rc = type=http-response, pattern=^https:\/\/(firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+), script-path=https://tommm1207.github.io/locket-tommm-studio/js_tommm_rc.js?v=58, requires-body=true, max-size=-1, timeout=60
tommm_ai_route = type=http-request, pattern=^https:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/.*(generateFilteredImage|generateFilter|applyFilter|createFilter|createCustomFilter|generateCustomFilter|createCameraFilter|createAiFilter|generateAiFilter|createUserFilter|saveFilter|saveCustomFilter|createLook|generateLook|customFilter|customFilters|userFilters|validateFilter|checkFilter|generateCaption|ai-filters), script-path=https://tommm1207.github.io/locket-tommm-studio/js_tommm_ai_route.js?v=58, timeout=60
tommm_yt_music_post = type=http-request, pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/.*(postMoment|createMoment), script-path=https://tommm1207.github.io/locket-tommm-studio/js_tommm_yt_music.js?v=58, requires-body=true, max-size=524288, timeout=10
tommm_uid_req = type=http-request, pattern=^https:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/(?!(generateFilteredImage|generateFilter|applyFilter|createFilter|generateCaption|ai-filters|postMoment|createMoment|changeProfileInfo)).+, script-path=https://tommm1207.github.io/locket-tommm-studio/js_tommm_badge.js?v=58, timeout=60
tommm_badge_req = type=http-request, pattern=^https:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/.*changeProfileInfo, script-path=https://tommm1207.github.io/locket-tommm-studio/js_tommm_badge.js?v=58, requires-body=true, max-size=131072, timeout=60
tommm_badge_res = type=http-response, pattern=^https:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/(?!(generateFilteredImage|generateFilter|applyFilter|createFilter|generateCaption|ai-filters)).+, script-path=https://tommm1207.github.io/locket-tommm-studio/js_tommm_badge.js?v=58, requires-body=true, max-size=1048576, timeout=60
tommm_yt_playback = type=http-request, pattern=^https?:\/\/(s|www|music|m)\.youtube\.com\/api\/stats\/(playback|watchtime|qoe), script-path=https://tommm1207.github.io/locket-tommm-studio/js_tommm_yt_music.js?v=58, requires-body=false, timeout=5
tommm_yt_music_sniffer = type=http-request, pattern=^https?:\/\/(youtubei\.googleapis\.com|music\.youtube\.com)\/youtubei\/v1\/(player|get_watch), script-path=https://tommm1207.github.io/locket-tommm-studio/js_tommm_yt_music.js?v=58, requires-body=true, binary-body-mode=true, max-size=65536, timeout=5

[MITM]
hostname = %APPEND%, *.googlevideo.com, youtubei.googleapis.com, music.youtube.com, m.youtube.com, www.youtube.com, s.youtube.com, -redirector*.googlevideo.com, api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.rc-backup.com, us-central1-locket-4252a.cloudfunctions.net, api.locketcamera.com
